# ---- LMS backend settings ----
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=*
CORS_ORIGINS=http://localhost:5174

# Database: sqlite (default, zero setup) | postgresql | mysql
DB_ENGINE=sqlite
# --- MySQL: set DB_ENGINE=mysql and un-comment these ---
# DB_NAME=lms_db
# DB_USER=lmsuser
# DB_PASSWORD=your-password
# DB_HOST=127.0.0.1
# DB_PORT=3306

# First administrator (created automatically on the first `migrate`)
ADMIN_USERNAME=VarshiniShan
ADMIN_PASSWORD=VarshiniShan

# --- Hosting (Render etc.): set these as environment variables instead of a .env file ---
# DATABASE_URL=mysql://user:password@host:3306/dbname      (or postgres://...)
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=<long random string>
# ALLOWED_HOSTS=your-backend.onrender.com
# CORS_ORIGINS=https://your-frontend-url
